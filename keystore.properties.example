# Rename this file to "keystore.properties" and fill in real values to build a
# SIGNED release. Without it, gradle / build_release.bat produce an UNSIGNED
# release APK (fine for testing).
#
# Put the .jks keystore itself under keystore/ (that folder is gitignored too).
# NEVER commit real passwords or the .jks file.

storeFile=keystore/rutts-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=rutts-release
keyPassword=YOUR_KEY_PASSWORD
storeType=JKS
